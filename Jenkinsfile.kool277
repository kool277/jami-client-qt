// kool277 pipeline for kool277/jami-client-qt (multibranch job from
// ci/jenkins/setup.sh in kool277/jami). The build scripts live in the
// workspace repository kool277/jami: each build fetches it (outside the
// checkout, into $WORKSPACE_TMP/kool277) at the same tag for a v* release,
// else main. Builds reuse build/ and the daemon's contrib tree of the previous
// build in this Jenkins workspace.
//
// The client builds against its daemon submodule; on a v* tag against the
// jami-daemon commit that the workspace pins, the one the platform release
// ships. Every build: build and the Qml_Tests/Unit_Tests suites in the
// ci/client-qt container. On a v* tag: package and publish the GitHub
// release (see RELEASING.md in kool277/jami). Needs the github-kool277
// credential, docker and /var/cache/jami on the agent.

def ciRef() { env.TAG_NAME?.startsWith('v') ? env.TAG_NAME : 'main' }

pipeline {
    agent any
    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 4, unit: 'HOURS')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        KOOL277 = "${env.WORKSPACE_TMP}/kool277"
        CI = "${env.WORKSPACE_TMP}/kool277/ci"
        CLIENT_DIR = "${env.WORKSPACE}"
        DAEMON_DIR = "${env.WORKSPACE}/daemon"
    }
    stages {
        stage('Sources') {
            steps {
                retry(3) {
                    sh "rm -rf \"\$KOOL277\" && git clone -q --depth 1 --branch ${ciRef()} https://github.com/kool277/jami.git \"\$KOOL277\""
                }
                retry(3) {
                    sh 'git submodule update --init daemon 3rdparty/hunspell 3rdparty/md4c 3rdparty/tidy-html5 3rdparty/zxing-cpp'
                }
                script {
                    if (env.TAG_NAME?.startsWith('v')) {
                        def pin = sh(returnStdout: true,
                                     script: "git -C \"\$KOOL277\" ls-tree HEAD jami-daemon | awk '{print \$3}'").trim()
                        retry(3) {
                            sh "git -C daemon fetch -q origin ${pin} && git -C daemon checkout -q ${pin}"
                        }
                    }
                }
                sh 'git -C daemon log --oneline -1'
            }
        }
        stage('Build') {
            steps {
                sh 'JOBS=$(nproc) "$CI/client-qt/run.sh"'
            }
        }
        stage('Test') {
            steps {
                sh 'SKIP_IMAGE_BUILD=1 "$CI/client-qt/run.sh" sh /ci/ci-test.sh'
            }
            post {
                always { junit allowEmptyResults: true, testResults: 'build/*-tests.xml' }
            }
        }
        stage('Release') {
            when { tag 'v*' }
            steps {
                sh 'VERSION="$TAG_NAME" DOCKER_RUN_ARGS="-e VERSION" SKIP_IMAGE_BUILD=1 "$CI/client-qt/run.sh" sh /ci/package.sh'
                archiveArtifacts artifacts: 'build/dist/*', fingerprint: true
                withCredentials([usernamePassword(credentialsId: 'github-kool277',
                                                  usernameVariable: 'GH_USER',
                                                  passwordVariable: 'GH_TOKEN')]) {
                    retry(3) {
                        sh '"$CI/release/publish-release.sh" jami-client-qt "$TAG_NAME" build/dist/*'
                    }
                }
            }
        }
    }
}
